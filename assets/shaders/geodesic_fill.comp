#version 430
layout(local_size_x=16, local_size_y=16) in;
layout(rgba8, binding=0) uniform image2D img;

uniform vec2  camC;
uniform float camS;
uniform float rEvent;
uniform float rDiskIn;
uniform float rDiskOut;
uniform bool  discOn;

void main(){
    ivec2 P = ivec2(gl_GlobalInvocationID.xy);
    ivec2 S = imageSize(img);
    if(P.x>=S.x || P.y>=S.y) return;

    vec2 uv = (vec2(P)+0.5)/vec2(S);
    vec2 p  = (uv*2.0 - 1.0)*camS + camC;
    float r = length(p);

    vec4 col;
    if(r < rEvent){
        col = vec4(0.86, 0.16, 0.10, 1.0);
    } else if(discOn && r>=rDiskIn && r<=rDiskOut){
        float t = clamp((r - rDiskIn)/(rDiskOut - rDiskIn), 0.0, 1.0);
        float R = (200.0 + 30.0*(1.0-t))/255.0;
        float G = (160.0 + 60.0*t)/255.0;
        float B = ( 40.0 + 20.0*(1.0-t))/255.0;
        col = vec4(R,G,B,1.0);
    } else {
        float ny = (p.y + 1.0)*0.5;
        col = vec4(8.0/255.0, (12.0+40.0*ny)/255.0, 12.0/255.0, 1.0);
    }
    imageStore(img, P, col);
}
